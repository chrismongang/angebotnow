generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  type       String?  @default("email") // email-verification, password-reset

  @@unique([identifier, token])
}

// Custom User Model (extends NextAuth User)
model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  companyName     String?
  street          String?
  city            String?
  phone           String?
  taxNumber       String?
  vatNumber       String?
  bankName        String?
  bankAccount     String?
  bankBic         String?
  lastQuoteNumber Int       @default(0)
  currentYear     Int       @default(2025)
  taxOffice       String?
  password        String?
  firstName       String?
  lastName        String?
  
  // Subscription fields
  stripeCustomerId String? @unique
  subscriptionId   String?
  subscriptionStatus SubscriptionStatus @default(FREE)
  subscriptionTier SubscriptionTier @default(FREE)
  subscriptionEndDate DateTime?
  monthlyQuoteCount Int @default(0)
  quoteCountResetDate DateTime @default(now())
  
  accounts        Account[]
  quotes          Quote[]
  sessions        Session[]
}

model Quote {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  clientName  String
  projectInfo String
  status      QuoteStatus @default(PENDING)
  imagePath   String?
  pdfPath     String?
  aiData      Json?
  quoteNumber String?    // Structured quote number (e.g., AN20250001)
  clientStreet String?   // Client address - street
  clientCity   String?   // Client address - city
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum QuoteStatus {
  PENDING
  AI_DONE
  COMPLETED
  FAILED
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum SubscriptionTier {
  FREE
  PRO
}
