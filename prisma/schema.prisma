generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  type       String?  @default("email")

  @@unique([identifier, token])
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  createdAt           DateTime           @default(now())
  bankAccount         String?
  bankBic             String?
  bankName            String?
  city                String?
  companyName         String?
  currentYear         Int                @default(2025)
  emailVerified       DateTime?
  image               String?
  lastQuoteNumber     Int                @default(0)
  phone               String?
  street              String?
  taxNumber           String?
  updatedAt           DateTime           @updatedAt
  vatNumber           String?
  taxOffice           String?
  password            String?
  firstName           String?
  lastName            String?
  monthlyQuoteCount   Int                @default(0)
  name                String?
  quoteCountResetDate DateTime           @default(now())
  stripeCustomerId    String?            @unique
  subscriptionEndDate DateTime?
  subscriptionId      String?
  subscriptionStatus  SubscriptionStatus @default(FREE)
  subscriptionTier    SubscriptionTier   @default(FREE)
  lastPaymentDate     DateTime?          // Datum der letzten Zahlung
  referralCode        String?            @unique // Eindeutiger Referral-Code
  referredBy          String?            // Wer hat diesen User eingeladen
  referralCredits     Int                @default(0) // Gratis-Credits für Referrals
  referralCount       Int                @default(0) // Anzahl erfolgreicher Referrals
  accounts            Account[]
  quotes              Quote[]
  sessions            Session[]
  referrals           User[]             @relation("UserReferrals") // Users die dieser User eingeladen hat
  referredByUser      User?              @relation("UserReferrals", fields: [referredBy], references: [id])
  referralInvites     ReferralInvite[]   // Einladungen die dieser User gesendet hat
  feedbacks           Feedback[]         // Feedback-Einträge des Users
}

model Quote {
  id           String      @id @default(cuid())
  userId       String
  clientName   String
  projectInfo  String
  status       QuoteStatus @default(PENDING)
  imagePath    String?
  pdfPath      String?
  aiData       Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  quoteNumber  String?
  clientCity   String?
  clientStreet String?
  user         User        @relation(fields: [userId], references: [id])
  feedbacks    Feedback[]  // Feedback-Einträge für dieses Angebot
}

enum QuoteStatus {
  PENDING
  AI_DONE
  COMPLETED
  FAILED
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum SubscriptionTier {
  FREE
  PRO
}

model ReferralInvite {
  id              String    @id @default(cuid())
  inviterId       String    // Wer lädt ein
  inviteeEmail    String    // E-Mail des Eingeladenen
  inviteCode      String    @unique // Eindeutiger Einladungscode
  status          ReferralStatus @default(PENDING)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime  // Einladung läuft ab
  acceptedAt      DateTime? // Wann wurde akzeptiert
  
  inviter         User      @relation(fields: [inviterId], references: [id])
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model Feedback {
  id          String        @id @default(cuid())
  userId      String        // User der das Feedback abgegeben hat
  quoteId     String        // Angebot für das Feedback abgegeben wurde
  rating      FeedbackRating // Daumen hoch/runter/neutral
  text        String?       // Optionaler Freitext (max 1000 Zeichen)
  status      FeedbackStatus @default(NEW) // Status für Admin-Verwaltung
  tags        String[]      // Tags für Kategorisierung (z.B. "UX", "Qualität", "Preis")
  adminNotes  String?       // Interne Notizen vom Admin
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote       Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  
  @@unique([userId, quoteId]) // Maximal ein Feedback pro User pro Angebot
}

enum FeedbackRating {
  UP      // Daumen hoch
  DOWN    // Daumen runter
  NEUTRAL // Neutral (falls später erweitert)
}

enum FeedbackStatus {
  NEW       // Neues Feedback, noch nicht bearbeitet
  TRIAGED   // Vom Admin kategorisiert
  IN_PROGRESS // In Bearbeitung
  RESOLVED  // Abgeschlossen
  IGNORED   // Ignoriert
}
